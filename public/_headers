# Netlify headers (copied to the site root on build).

# Hashed bundles never change under the same name: cache for a year.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images: cached for a week. Changing an image means a new file name (see CLAUDE.md).
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The component library (Storybook, production only): not for search engines (linked from the Work page hero).
/storybook/*
  X-Robots-Tag: noindex, nofollow

# Google Search Console's ownership file (never remove it): Google reads it, search results never show it.
/googlecf978c6093e1d8a5.html
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
