# Netlify headers (copied to the site root on build).

# Hashed bundles never change under the same name: cache for a year.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images: cached for a week. Changing an image means a new file name (see CLAUDE.md).
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Site icons (favicon.svg and the copies `yarn favicons` makes from it): Google asks for stable favicon URLs,
# so the names never change and the cache is short: a day, then refreshed in the background. Search engines
# must be able to fetch them: never an X-Robots-Tag here.
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon-96x96.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The CV as a PDF (`yarn cv-pdf`). Recruiters save this address, so the name never changes and every visit checks
# for a newer file (an old CV with wrong dates is worse than a quick check). Search engines should show the CV
# page, which has the same content: the canonical link points there. Never an X-Robots-Tag here.
/karolina-kita-cv.pdf
  Cache-Control: public, max-age=0, must-revalidate
  Link: <https://karolina.kita.company/cv>; rel="canonical"

# The component library (Storybook, production only): not for search engines (linked from the Behind the Design banner on the Work page).
/storybook/*
  X-Robots-Tag: noindex, nofollow

# Google Search Console's ownership file (never remove it): Google reads it, search results never show it.
/googlecf978c6093e1d8a5.html
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
