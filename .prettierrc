{
  "printWidth": 120,
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^#app/",
    "^#features/",
    "^#shared/",
    "^#test/",
    "",
    "^[.]"
  ],
  "importOrderTypeScriptVersion": "6.0.0",
  "tailwindStylesheet": "./src/styles/app.css"
}
