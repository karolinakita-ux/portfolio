{
  "name": "portfolio",
  "private": true,
  "version": "3.12.2",
  "description": "Karolina Kita - Senior Product Designer portfolio (karolina.kita.company)",
  "author": "Karolina Kita",
  "homepage": "https://karolina.kita.company",
  "repository": {
    "type": "git",
    "url": "https://github.com/karolinakita-ux/portfolio.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*",
    "#features/*": "./src/features/*",
    "#shared/*": "./src/shared/*",
    "#test/*": "./src/test/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && yarn -s prerender",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "a11y": "node scripts/a11y-audit.ts",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o dist/storybook --quiet",
    "verify": "tsc -b && eslint . --max-warnings 0 && prettier --check . && vitest run && vite build && yarn -s prerender",
    "format:check": "prettier --check .",
    "prerender": "vite build --ssr src/app/prerender.entry.tsx --outDir node_modules/.tmp/ssr --emptyOutDir --logLevel warn && node scripts/prerender.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-react/eslint-plugin": "^5.26.5",
    "@eslint/js": "^10.0.1",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "axe-core": "4.14.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "storybook": "10.6.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "resolutions": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
